# Database (Supabase / Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Authentication (Auth.js)
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Production: https://savepoint.life  |  Local: http://localhost:3000
NEXTAUTH_URL="https://savepoint.life"
# Auth.js v5 also reads AUTH_URL — set both on Vercel to the same production URL
AUTH_URL="https://savepoint.life"

# OAuth login (optional — leave blank to disable a provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
XBOX_CLIENT_ID=""
XBOX_CLIENT_SECRET=""

# IGDB via Twitch (required for Discover / game pages / recommendations)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Email (verification + password reset)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Cloudflare R2 (avatars / banners)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="savepoint-assets"
NEXT_PUBLIC_R2_PUBLIC_URL="https://your-bucket.r2.dev"

# NSFW moderation (required in production — uploads fail closed if missing)
SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""

# Optional: Steam library sync (backend; Settings UI may be hidden)
# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=""

# Optional: Xbox library sync via OpenXBL (backend; Settings UI may be hidden)
# https://xbl.io/ — separate from Xbox login OAuth
OPENXBL_API_KEY=""

# Unused by current recommendations engine (algorithmic IGDB). Safe to omit.
# GEMINI_API_KEY=""
