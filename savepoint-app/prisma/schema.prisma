generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Auth.js Models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model TrafficLog {
  id        String   @id @default(cuid())
  path      String
  method    String
  ip        String?
  userAgent String?
  timestamp DateTime @default(now())
}

model BannedIP {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// ============================================
// Core Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String    @unique
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  bio           String?
  bannerImage   String?
  onboarded     Boolean   @default(false)
  isAdmin       Boolean   @default(false)
  isBanned      Boolean   @default(false)
  bannedReason  String?
  lastIp        String?
  isPrivate     Boolean   @default(false)
  /// When true, other users can view this user's full library (even if profile is private).
  libraryPublic Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Notification preferences
  notifyOnFollow     Boolean @default(true)
  notifyOnReviewLike Boolean @default(true)
  notifyOnComment    Boolean @default(true)
  notifyOnListLike   Boolean @default(true)
  notifyOnGameRelease Boolean @default(true)

  // Gamification
  xp            Int       @default(0)
  equippedBadge String?

  // Connected libraries
  steamId          String?   @unique
  steamLinkedAt    DateTime?
  steamLastSyncAt  DateTime?
  xboxGamertag     String?
  xboxXuid         String?
  xboxLinkedAt     DateTime?
  xboxLastSyncAt   DateTime?

  // Relations
  accounts     Account[]
  sessions     Session[]
  userGames    UserGame[]
  reviews      Review[]
  reviewLikes  ReviewLike[]
  lists        List[]
  diaryEntries DiaryEntry[]
  comments     Comment[]
  commentLikes CommentLike[]
  listLikes    ListLike[]

  // Social
  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")

  // Favorites
  favoriteGames FavoriteGame[]

  // Release watches (notify when unreleased games launch)
  releaseWatches GameReleaseWatch[]

  // Upload Tracking
  imageUploads ImageUploadLog[]

  // Notifications
  notificationsReceived  Notification[] @relation("ReceivedNotifications")
  notificationsTriggered Notification[] @relation("TriggeredNotifications")

  // Feed Activities
  activities       Activity[]
  activityLikes    ActivityLike[]
  activityComments ActivityComment[]

  // Gamification
  badges           UserBadge[]

  // Moderation
  reportsFiled    Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportedUser")
}

model ImageUploadLog {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================
// Gamification
// ============================================

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String   // The code-level identifier for the badge
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Game {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  coverImage  String?
  bannerImage String?
  releaseDate DateTime?
  developer   String?
  publisher   String?
  igdbId      Int?     @unique
  steamAppId  Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Aggregated stats (denormalized for performance)
  avgRating    Float  @default(0)
  ratingCount  Int    @default(0)
  reviewCount  Int    @default(0)
  /// Mean playtime across users who imported hours (Steam/Xbox), in minutes
  avgPlaytimeMinutes  Float @default(0)
  /// How many user libraries contributed to avgPlaytimeMinutes
  playtimeSampleCount Int   @default(0)

  // Relations
  genres       GameGenre[]
  platforms    GamePlatform[]
  userGames    UserGame[]
  reviews      Review[]
  listItems    ListItem[]
  diaryEntries DiaryEntry[]
  favoriteOf   FavoriteGame[]
  releaseWatches GameReleaseWatch[]
  notifications  Notification[]
}

/// Users waiting for an unreleased title; notified once after releaseDate passes.
model GameReleaseWatch {
  id         String    @id @default(cuid())
  userId     String
  gameId     String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, notifiedAt])
  @@index([userId])
}

model GameGenre {
  id     String @id @default(cuid())
  gameId String
  genre  String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, genre])
  @@index([genre])
}

model GamePlatform {
  id       String @id @default(cuid())
  gameId   String
  platform String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, platform])
  @@index([platform])
}

// ============================================
// Game Tracking
// ============================================

model UserGame {
  id              String    @id @default(cuid())
  userId          String
  gameId          String
  status          String    // WANT_TO_PLAY, PLAYING, COMPLETED, DROPPED
  rating          Float?    // 0.5 to 5.0, half-star increments
  playtimeMinutes Int       @default(0)
  source          String?   // MANUAL, STEAM, XBOX
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  activity Activity?

  @@unique([userId, gameId])
  @@index([userId, status])
  @@index([gameId])
}

model FavoriteGame {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  activity Activity?

  @@unique([userId, gameId])
  @@index([userId])
}

// ============================================
// Reviews
// ============================================

model Review {
  id               String   @id @default(cuid())
  userId           String
  gameId           String
  rating           Float    // 0.5 to 5.0
  text             String
  containsSpoilers Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  game          Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  likes         ReviewLike[]
  comments      Comment[]
  notifications Notification[]
  activity      Activity?

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([createdAt])
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

// ============================================
// Lists
// ============================================

model List {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  visibility  String   @default("PUBLIC") // PUBLIC, PRIVATE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
  likes ListLike[]
  notifications Notification[]
  activity Activity?

  @@index([userId])
  @@index([visibility])
}

model ListLike {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String
  gameId    String
  order     Int      @default(0)
  notes     String?  // Custom note for this list item
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([listId, gameId])
  @@index([listId])
}

// ============================================
// Gaming Diary
// ============================================

model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  date      DateTime
  status    String?  // WANT_TO_PLAY, PLAYING, COMPLETED, DROPPED
  rating    Float?
  notes     String?
  playtime  Int?     // Playtime in hours
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([gameId])
}

// ============================================
// Activity Feed
// ============================================

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'REVIEW', 'LIST', 'TRACKING', 'FAVORITE'
  createdAt DateTime @default(now())

  // Polymorphic relations
  reviewId   String?  @unique
  listId     String?  @unique
  userGameId String?  @unique
  favoriteId String?  @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  review       Review?       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  list         List?         @relation(fields: [listId], references: [id], onDelete: Cascade)
  userGame     UserGame?     @relation(fields: [userGameId], references: [id], onDelete: Cascade)
  favorite     FavoriteGame? @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  
  likes        ActivityLike[]
  comments     ActivityComment[]

  @@index([userId])
  @@index([createdAt])
}

model ActivityLike {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([activityId])
}

model ActivityComment {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

// ============================================
// Social
// ============================================

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================
// Comments
// ============================================

model Comment {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  likes  CommentLike[]

  @@index([reviewId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String?
  targetType     String   // REVIEW, COMMENT, PROFILE, LIST
  targetId       String
  reason         String   // SPAM, HARASSMENT, HATE_SPEECH, SEXUAL_CONTENT, COPYRIGHT, OTHER
  details        String?
  status         String   @default("OPEN") // OPEN, RESOLVED, DISMISSED
  createdAt      DateTime @default(now())

  reporter     User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

// ============================================
// Notifications
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String   // The user receiving the notification
  type      String   // 'FOLLOW', 'REVIEW_LIKE', 'COMMENT', 'LIST_LIKE', 'GAME_RELEASED'
  sourceId  String?  // ID of the user who triggered it
  reviewId  String?  // Optional reference to a review
  listId    String?  // Optional reference to a list
  gameId    String?  // Optional reference to a game (e.g. release alerts)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  source    User?    @relation("TriggeredNotifications", fields: [sourceId], references: [id], onDelete: Cascade)
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  list      List?    @relation(fields: [listId], references: [id], onDelete: Cascade)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([sourceId])
  @@index([gameId])
  @@index([createdAt])
}

