generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Auth.js Models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model TrafficLog {
  id        String   @id @default(cuid())
  path      String
  method    String
  ip        String?
  userAgent String?
  timestamp DateTime @default(now())
}

model BannedIP {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// ============================================
// Core Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String    @unique
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  bio           String?
  bannerImage   String?
  onboarded     Boolean   @default(false)
  isAdmin       Boolean   @default(false)
  isBanned      Boolean   @default(false)
  bannedReason  String?
  /// Blue verified badge (Instagram-style)
  isVerified    Boolean   @default(false)
  /// Green official badge (Savepoint account); wins over isVerified in UI
  isOfficial    Boolean   @default(false)
  lastIp        String?
  isPrivate     Boolean   @default(false)
  /// When true, other users can view this user's full library (even if profile is private).
  libraryPublic Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Notification preferences
  notifyOnFollow     Boolean @default(true)
  notifyOnReviewLike Boolean @default(true)
  notifyOnComment    Boolean @default(true)
  notifyOnListLike   Boolean @default(true)
  notifyOnGameRelease Boolean @default(true)
  notifyOnMessage      Boolean @default(true)
  emailOnMessage       Boolean @default(true)

  // E2E messaging — public key only (private key never leaves the client)
  e2ePublicKey       String?   @db.Text
  e2ePublicKeyUpdatedAt DateTime?

  // Gamification
  xp            Int       @default(0)
  equippedBadge String?

  // Connected libraries
  steamId          String?   @unique
  steamLinkedAt    DateTime?
  steamLastSyncAt  DateTime?
  xboxGamertag     String?
  xboxXuid         String?
  xboxLinkedAt     DateTime?
  xboxLastSyncAt   DateTime?
  psnAccountId     String?   @unique
  psnOnlineId      String?
  /// AES-GCM sealed refresh token (never store raw NPSSO)
  psnRefreshToken  String?   @db.Text
  psnAccessToken   String?   @db.Text
  psnTokenExpiresAt DateTime?
  psnLinkedAt      DateTime?
  psnLastSyncAt    DateTime?
  // Cached PSN trophy profile summary
  psnTrophyLevel   Int?
  psnTrophyTier    Int?
  psnTrophyProgress Int?
  psnEarnedBronze  Int       @default(0)
  psnEarnedSilver  Int       @default(0)
  psnEarnedGold    Int       @default(0)
  psnEarnedPlatinum Int      @default(0)

  // Relations
  accounts     Account[]
  sessions     Session[]
  userGames    UserGame[]
  reviews      Review[]
  reviewLikes  ReviewLike[]
  lists        List[]
  diaryEntries DiaryEntry[]
  comments     Comment[]
  commentLikes CommentLike[]
  listLikes    ListLike[]
  psnTitles    PsnTitleProgress[]
  psnTrophies  PsnTrophy[]

  // Social
  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")

  friendRequestsSent     Friendship[] @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[] @relation("FriendRequestsReceived")

  conversationsAsUserOne Conversation[] @relation("ConversationUserOne")
  conversationsAsUserTwo Conversation[] @relation("ConversationUserTwo")
  messagesSent           DirectMessage[] @relation("MessagesSent")

  // Favorites
  favoriteGames FavoriteGame[]

  // Release watches (notify when unreleased games launch)
  releaseWatches GameReleaseWatch[]

  // Upload Tracking
  imageUploads ImageUploadLog[]

  // Notifications
  notificationsReceived  Notification[] @relation("ReceivedNotifications")
  notificationsTriggered Notification[] @relation("TriggeredNotifications")

  // Feed Activities
  activities       Activity[]
  activityLikes    ActivityLike[]
  activityComments ActivityComment[]

  // Gamification
  badges           UserBadge[]

  // Moderation
  reportsFiled    Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportedUser")

  // Forums
  forumsOwned       Forum[]       @relation("ForumOwner")
  forumsDeleted     Forum[]       @relation("ForumDeletedBy")
  forumMemberships  ForumMember[]
  forumTopics       ForumTopic[]
  forumReplies      ForumReply[]
  forumTopicVotes   ForumTopicVote[]
  forumReplyVotes   ForumReplyVote[]
}

model ImageUploadLog {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================
// Gamification
// ============================================

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String   // The code-level identifier for the badge
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Game {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  coverImage  String?
  bannerImage String?
  releaseDate DateTime?
  developer   String?
  publisher   String?
  igdbId      Int?     @unique
  steamAppId  Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Aggregated stats (denormalized for performance)
  avgRating    Float  @default(0)
  ratingCount  Int    @default(0)
  reviewCount  Int    @default(0)
  /// Mean playtime across users who imported hours (Steam/Xbox/PSN), in minutes
  avgPlaytimeMinutes  Float @default(0)
  /// How many user libraries contributed to avgPlaytimeMinutes
  playtimeSampleCount Int   @default(0)

  // Relations
  genres       GameGenre[]
  platforms    GamePlatform[]
  userGames    UserGame[]
  reviews      Review[]
  listItems    ListItem[]
  diaryEntries DiaryEntry[]
  favoriteOf   FavoriteGame[]
  releaseWatches GameReleaseWatch[]
  notifications  Notification[]
  psnTitles    PsnTitleProgress[]
}

/// Users waiting for an unreleased title; notified once after releaseDate passes.
model GameReleaseWatch {
  id         String    @id @default(cuid())
  userId     String
  gameId     String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, notifiedAt])
  @@index([userId])
}

model GameGenre {
  id     String @id @default(cuid())
  gameId String
  genre  String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, genre])
  @@index([genre])
}

model GamePlatform {
  id       String @id @default(cuid())
  gameId   String
  platform String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, platform])
  @@index([platform])
}

// ============================================
// Game Tracking
// ============================================

model UserGame {
  id              String    @id @default(cuid())
  userId          String
  gameId          String
  status          String    // WANT_TO_PLAY, PLAYING, COMPLETED, DROPPED
  rating          Float?    // 0.5 to 5.0, half-star increments
  playtimeMinutes Int       @default(0)
  source          String?   // MANUAL, STEAM, XBOX, PSN
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  activity Activity?

  @@unique([userId, gameId])
  @@index([userId, status])
  @@index([gameId])
}

/// Per-user PSN trophy title progress (matched to a Savepoint game when possible).
model PsnTitleProgress {
  id                String   @id @default(cuid())
  userId            String
  gameId            String?
  npCommunicationId String
  npServiceName     String   @default("trophy")
  titleName         String
  platform          String?
  progress          Int      @default(0)
  earnedBronze      Int      @default(0)
  earnedSilver      Int      @default(0)
  earnedGold        Int      @default(0)
  earnedPlatinum    Int      @default(0)
  definedBronze     Int      @default(0)
  definedSilver     Int      @default(0)
  definedGold       Int      @default(0)
  definedPlatinum   Int      @default(0)
  iconUrl           String?
  lastUpdatedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([userId, npCommunicationId])
  @@index([userId, gameId])
  @@index([gameId])
}

/// Individual PSN trophies for a title (synced for matched / recently played titles).
model PsnTrophy {
  id                String    @id @default(cuid())
  userId            String
  npCommunicationId String
  trophyId          Int
  trophyName        String
  trophyDetail      String?   @db.Text
  trophyType        String
  trophyIconUrl     String?
  trophyGroupId     String?
  earned            Boolean   @default(false)
  earnedDateTime    DateTime?
  rarity            Int?
  earnedRate        Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, npCommunicationId, trophyId])
  @@index([userId, npCommunicationId])
}

model FavoriteGame {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  activity Activity?

  @@unique([userId, gameId])
  @@index([userId])
}

// ============================================
// Reviews
// ============================================

model Review {
  id               String   @id @default(cuid())
  userId           String
  gameId           String
  rating           Float    // 0.5 to 5.0
  text             String
  containsSpoilers Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  game          Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  likes         ReviewLike[]
  comments      Comment[]
  notifications Notification[]
  activity      Activity?

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([createdAt])
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

// ============================================
// Lists
// ============================================

model List {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  visibility  String   @default("PUBLIC") // PUBLIC, PRIVATE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
  likes ListLike[]
  notifications Notification[]
  activity Activity?

  @@index([userId])
  @@index([visibility])
}

model ListLike {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String
  gameId    String
  order     Int      @default(0)
  notes     String?  // Custom note for this list item
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([listId, gameId])
  @@index([listId])
}

// ============================================
// Gaming Diary
// ============================================

model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  date      DateTime
  status    String?  // WANT_TO_PLAY, PLAYING, COMPLETED, DROPPED
  rating    Float?
  notes     String?
  playtime  Int?     // Playtime in hours
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([gameId])
}

// ============================================
// Activity Feed
// ============================================

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'REVIEW', 'LIST', 'TRACKING', 'FAVORITE'
  createdAt DateTime @default(now())

  // Polymorphic relations
  reviewId   String?  @unique
  listId     String?  @unique
  userGameId String?  @unique
  favoriteId String?  @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  review       Review?       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  list         List?         @relation(fields: [listId], references: [id], onDelete: Cascade)
  userGame     UserGame?     @relation(fields: [userGameId], references: [id], onDelete: Cascade)
  favorite     FavoriteGame? @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  
  likes        ActivityLike[]
  comments     ActivityComment[]

  @@index([userId])
  @@index([createdAt])
}

model ActivityLike {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([activityId])
}

model ActivityComment {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

// ============================================
// Social
// ============================================

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

/// Directed friendship request. ACCEPTED means both users are friends.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// 1:1 DM thread. userOneId < userTwoId lexicographically for uniqueness.
model Conversation {
  id            String   @id @default(cuid())
  userOneId     String
  userTwoId     String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userOne  User            @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User            @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId, lastMessageAt])
  @@index([userTwoId, lastMessageAt])
}

/// CHAT messages store E2E ciphertext; SYSTEM messages use systemPayload (e.g. forum invites).
model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  /// CHAT | SYSTEM
  kind           String    @default("CHAT")
  /// Base64 AES-GCM ciphertext (empty for SYSTEM)
  ciphertext     String    @db.Text @default("")
  /// Base64 IV (empty for SYSTEM)
  iv             String    @default("")
  /// JSON for SYSTEM messages
  systemPayload  String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Set when the sender replaces ciphertext (client re-encrypts).
  editedAt       DateTime?
  /// When the recipient opened the chat and marked this inbound message read.
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, updatedAt])
  @@index([senderId])
}

// ============================================
// Comments
// ============================================

model Comment {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  likes  CommentLike[]

  @@index([reviewId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String?
  targetType     String   // REVIEW, COMMENT, PROFILE, LIST
  targetId       String
  reason         String   // SPAM, HARASSMENT, HATE_SPEECH, SEXUAL_CONTENT, COPYRIGHT, OTHER
  details        String?
  status         String   @default("OPEN") // OPEN, RESOLVED, DISMISSED
  createdAt      DateTime @default(now())

  reporter     User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

// ============================================
// Notifications
// ============================================

model Notification {
  id             String   @id @default(cuid())
  userId         String   // The user receiving the notification
  type           String   // 'FOLLOW', 'REVIEW_LIKE', 'COMMENT', 'LIST_LIKE', 'GAME_RELEASED', 'FRIEND_REQUEST', 'FRIEND_ACCEPTED', 'MESSAGE', 'FORUM_INVITE'
  sourceId       String?  // ID of the user who triggered it
  reviewId       String?  // Optional reference to a review
  listId         String?  // Optional reference to a list
  gameId         String?  // Optional reference to a game (e.g. release alerts)
  conversationId String?  // Optional DM conversation
  forumId        String?  // Optional forum (e.g. invites)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user      User     @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  source    User?    @relation("TriggeredNotifications", fields: [sourceId], references: [id], onDelete: Cascade)
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  list      List?    @relation(fields: [listId], references: [id], onDelete: Cascade)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  forum     Forum?   @relation(fields: [forumId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([sourceId])
  @@index([gameId])
  @@index([conversationId])
  @@index([forumId])
  @@index([createdAt])
}

// ============================================
// Forums
// ============================================

model Forum {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  description   String?   @db.Text
  coverImage    String?
  ownerId       String
  /// OPEN | CLOSED | ARCHIVED | DELETED
  status        String    @default("OPEN")
  deletedAt     DateTime?
  deletedReason String?   @db.Text
  deletedById   String?
  memberCount   Int       @default(1)
  topicCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner     User          @relation("ForumOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  deletedBy User?         @relation("ForumDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  members   ForumMember[]
  topics    ForumTopic[]
  notifications Notification[]

  @@index([status, createdAt])
  @@index([ownerId])
}

model ForumMember {
  id       String   @id @default(cuid())
  forumId  String
  userId   String
  /// OWNER | MEMBER
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  forum Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([forumId, userId])
  @@index([userId])
}

model ForumTopic {
  id        String   @id @default(cuid())
  forumId   String
  authorId  String
  title     String
  body      String   @db.Text
  imageUrls String[] @default([])
  /// OPEN | CLOSED
  status    String   @default("OPEN")
  score     Int      @default(0)
  isPinned  Boolean  @default(false)
  pinnedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forum   Forum            @relation(fields: [forumId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]
  votes   ForumTopicVote[]

  @@index([forumId, isPinned, createdAt])
  @@index([forumId, score])
  @@index([authorId])
}

model ForumReply {
  id        String   @id @default(cuid())
  topicId   String
  authorId  String
  /// Nested reply parent (null = top-level answer)
  parentId  String?
  body      String   @db.Text
  imageUrls String[] @default([])
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic    ForumTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   ForumReply?     @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children ForumReply[]    @relation("ReplyThread")
  votes    ForumReplyVote[]

  @@index([topicId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model ForumTopicVote {
  id        String   @id @default(cuid())
  topicId   String
  userId    String
  /// 1 = upvote, -1 = downvote
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([userId])
}

model ForumReplyVote {
  id        String   @id @default(cuid())
  replyId   String
  userId    String
  /// 1 = upvote, -1 = downvote
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reply ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([userId])
}

